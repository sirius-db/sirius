# name: test/sql/sirius_gateway_state.test
# description: the DDL log saved in sirius_gateway_state_dir, and replayed by a gateway that restarted
# group: [sirius_gateway]

require sirius_gateway

require quack

# Quack's errors mention HTTP, which the runner would otherwise take as a reason to skip the file.
set ignore_error_messages

statement ok
SET GLOBAL sirius_gateway_duckdb_binary = '{BUILD_DIRECTORY}/duckdb';

statement ok
SET GLOBAL sirius_gateway_query_id_setting = 'VARIABLE sirius_query_id';

statement ok
SET GLOBAL sirius_gateway_log_dir = '{TEST_DIR}/sirius_gateway_state';

statement ok
SET GLOBAL sirius_gateway_state_dir = '{TEST_DIR}/sirius_gateway_state/state';

statement ok
SET GLOBAL sirius_gateway_rank_boot_id_sql = 'SELECT 1';

statement ok
SET GLOBAL sirius_gateway_rank_joined_sql = 'SELECT false';

statement ok
FROM sirius_gateway_test_serve(19950, 'statetoken', '');

statement ok
FROM sirius_gateway_add_rank('127.0.0.1:19950', exchange_port := 27250, token := 'statetoken', name := 'a');

statement ok
FROM sirius_gateway_run('CREATE VIEW v AS SELECT 42 AS x');

statement ok
FROM sirius_gateway_run('CREATE VIEW w AS
SELECT 1 AS y -- one; two
');

statement ok
FROM sirius_gateway_run('CREATE SECRET s (TYPE s3, KEY_ID ''key'', SECRET ''hidden'')');

statement ok
FROM sirius_gateway_run('SET s3_secret_access_key = ''hidden''');

query I
SELECT count(*) FROM sirius_gateway_log();
----
4

# Statements with credentials stay in memory only.
query I
SELECT content LIKE '%hidden%' FROM read_text('{TEST_DIR}/sirius_gateway_state/state/ddl.sql');
----
false

# A new gateway, its ranks registered again and new processes: they replay the saved log.
restart

statement ok
SET GLOBAL sirius_gateway_duckdb_binary = '{BUILD_DIRECTORY}/duckdb';

statement ok
SET GLOBAL sirius_gateway_query_id_setting = 'VARIABLE sirius_query_id';

statement ok
SET GLOBAL sirius_gateway_log_dir = '{TEST_DIR}/sirius_gateway_state';

statement ok
SET GLOBAL sirius_gateway_state_dir = '{TEST_DIR}/sirius_gateway_state/state';

statement ok
SET GLOBAL sirius_gateway_rank_boot_id_sql = 'SELECT 1';

statement ok
SET GLOBAL sirius_gateway_rank_joined_sql = 'SELECT false';

statement ok
FROM sirius_gateway_test_serve(19951, 'statetoken', '');

statement ok
FROM sirius_gateway_add_rank('127.0.0.1:19951', exchange_port := 27251, token := 'statetoken', name := 'a');

query II
FROM sirius_gateway_run('SELECT (FROM v), (FROM w)');
----
42	1

query IT
SELECT entry, sql = 'CREATE VIEW w AS' || chr(10) || 'SELECT 1 AS y -- one; two' || chr(10) FROM sirius_gateway_log() ORDER BY entry;
----
1	false
2	true

# An explicit start clears the log, and the file.
statement ok
FROM sirius_gateway_start(0);

query I
SELECT count(*) FROM glob('{TEST_DIR}/sirius_gateway_state/state/*');
----
0

statement ok
FROM sirius_gateway_stop();
