# name: test/sql/sirius_gateway.test
# description: the gateway over CPU ranks: plain DuckDB with quack_serve, no Sirius
# group: [sirius_gateway]

require sirius_gateway

require quack

# Quack's errors mention HTTP, which the runner would otherwise take as a reason to skip the file.
set ignore_error_messages

statement ok
SET GLOBAL sirius_gateway_duckdb_binary = '{BUILD_DIRECTORY}/duckdb';

# CPU ranks have no sirius_distributed_query_id; a variable shows the number each rank got.
statement ok
SET GLOBAL sirius_gateway_query_id_setting = 'VARIABLE sirius_query_id';

statement ok
SET GLOBAL sirius_gateway_log_dir = '{TEST_DIR}/sirius_gateway';

# With no ranks, a statement waits sirius_gateway_join_wait seconds for some to register.
statement ok
SET GLOBAL sirius_gateway_join_wait = 0;

statement error
FROM sirius_gateway_run('SELECT 1');
----
no ranks

# With no ranks, a catalog read is answered from the gateway's own catalog; repeated column
# names are renamed there as Quack renames them on the way from a rank.
query II
FROM sirius_gateway_run('SELECT 1 AS a, 2 AS a FROM duckdb_settings() LIMIT 1');
----
1	2

query I
SELECT count(*) FROM sirius_gateway_start(2, quack_base_port := 19500) WHERE state = 'up';
----
2

# Every rank runs every statement, numbered in order; rank 0's result comes back.
statement ok
FROM sirius_gateway_run('CREATE VIEW v AS SELECT 42 AS x');

query II
FROM sirius_gateway_run('SELECT getvariable(''sirius_query_id''), (FROM v)');
----
2	42

query II
FROM sirius_gateway_log();
----
1	CREATE VIEW v AS SELECT 42 AS x

# Failing on every rank is an ordinary error, and the ranks keep serving.
statement error
FROM sirius_gateway_run('FROM missing_table');
----
missing_table

query I
SELECT count(*) FROM sirius_gateway_status() WHERE state = 'up';
----
2

# Statements from concurrent connections run one at a time, each with its own number.
statement ok
FROM sirius_gateway_run('CREATE TABLE t (k BIGINT)');

concurrentloop i 0 4

loop j 0 5

statement ok
FROM sirius_gateway_run('INSERT INTO t VALUES (getvariable(''sirius_query_id''))');

endloop

endloop

query II
FROM sirius_gateway_run('SELECT count(*), count(DISTINCT k) FROM t');
----
20	20

# A statement that succeeds on some ranks only leaves them out of step: the gateway reports it,
# then restarts the ranks and replays the DDL log before the next statement.
statement error
FROM sirius_gateway_run('SELECT CASE WHEN (SELECT port FROM quack_server_list()) = 19501 THEN error(''only rank 1'') ELSE 1 END');
----
ranks disagree

query II
FROM sirius_gateway_run('SELECT (FROM v), (SELECT count(*) FROM t)');
----
42	20

statement ok
FROM sirius_gateway_restart();

query I
FROM sirius_gateway_run('FROM v');
----
42

# A statement past the timeout is cancelled on every rank; the ranks keep serving.
statement ok
SET sirius_gateway_statement_timeout = 1;

statement error
FROM sirius_gateway_run('SELECT sum(i) FROM range(1000000000000) r(i)');
----
timed out

# A timeout too long for the clock is clamped, not wrapped into the past.
statement ok
SET sirius_gateway_statement_timeout = 18446744073709551615;

query I
FROM sirius_gateway_run('SELECT 1');
----
1

statement ok
SET sirius_gateway_statement_timeout = 0;

query I
SELECT count(*) FROM sirius_gateway_status() WHERE state = 'up';
----
2

# Clients reach the gateway over Quack; the router sends their statements to every rank.
statement ok
SET GLOBAL quack_authorization_function = 'sirius_gateway_route';

statement ok
CALL quack_serve('quack:127.0.0.1:19510', token := 'gateway-token');

statement ok con2
ATTACH 'quack:127.0.0.1:19510' AS gw (TOKEN 'gateway-token');

statement ok con2
CONNECT gw;

query I con2
FROM v;
----
42

query I con2
SELECT count(*) FROM sirius_gateway_status();
----
2

statement error con2
SET sirius_exchange_rank = 1;
----
set on every rank by the gateway

statement error con2
SET gpu_execution = false;
----
set on every rank by the gateway

statement error con2
SET sirius_exchange_host_staging = 'always';
----
set on every rank by the gateway

# A client's transaction stays in its own gateway session; the shared rank sessions never see it.
query I
SELECT sirius_gateway_route('', 'BEGIN TRANSACTION; SELECT 1; COMMIT') = 'BEGIN TRANSACTION' || chr(10) || ';' || chr(10) || 'FROM sirius_gateway_run(''SELECT 1'');' || chr(10) || 'COMMIT' || chr(10) || ';' || chr(10);
----
true

# A line comment at the end of a statement that stays on the gateway does not take its terminator.
query I
SELECT sirius_gateway_route('', 'BEGIN -- note') = 'BEGIN -- note' || chr(10) || ';' || chr(10);
----
true

# Text that does not parse is refused whole: run as written, the client's gateway session would
# execute the statements before the bad one, unrouted.
statement error
SELECT sirius_gateway_route('', 'SET GLOBAL sirius_gateway_min_ranks = 7; THIS IS NOT SQL');
----
syntax error

statement ok con2
BEGIN TRANSACTION;

query I con2
FROM v;
----
42

statement ok con2
COMMIT;

statement error con2
PREPARE p AS SELECT 1;
----
not supported through the gateway

statement error con2
FROM sirius_gateway_stop();
----
gateway's console

statement error con2
FROM quack_query('quack:127.0.0.1:19500', 'SELECT 1');
----
gateway's console

statement error con2
CALL sirius_rank_exit();
----
gateway's console

# A console-only call is refused at any depth, not only at the statement's top level.
statement error con2
SELECT * FROM sirius_gateway_status() WHERE EXISTS (FROM sirius_gateway_stop());
----
gateway's console

statement error con2
WITH s AS (FROM sirius_gateway_stop()) SELECT count(*) FROM sirius_gateway_status();
----
gateway's console

# Nor in a statement that is neither a SELECT nor a CALL: the ranks would run it.
statement error con2
CREATE TABLE t_exit AS FROM sirius_rank_exit();
----
gateway's console

statement error con2
INSERT INTO t FROM sirius_rank_exit();
----
gateway's console

statement error con2
COPY (FROM sirius_rank_exit()) TO '/dev/null';
----
gateway's console

statement error con2
CREATE VIEW v_exit AS FROM "sirius_rank_exit" /* quoted */ ();
----
gateway's console

statement error con2
CREATE MACRO m_servers() AS TABLE FROM quack_server_list();
----
gateway's console

statement error con2
EXPLAIN ANALYZE FROM sirius_gateway_stop();
----
gateway's console

statement error con2
SET VARIABLE n = (SELECT count(*) FROM sirius_rank_exit());
----
gateway's console

# A function clients may call still runs on the gateway only.
statement error con2
CREATE TABLE t_status AS FROM sirius_gateway_status();
----
only be called in a SELECT or a CALL

# Such a name that is not called passes: here in a string and as a column.
statement ok con2
CREATE TABLE t_names AS SELECT 'sirius_rank_exit()' AS quack_note;

query T con2
SELECT quack_note FROM t_names;
----
sirius_rank_exit()

# A statement that runs on the gateway reads nothing there but the gateway's own functions.
statement error con2
SELECT * FROM sirius_gateway_status(), query('FROM sirius_gateway_stop()');
----
cannot read tables, files or other table functions

statement error con2
SELECT * FROM sirius_gateway_status(), read_text('/etc/hostname');
----
cannot read tables, files or other table functions

# One of the statement's own CTEs is not a table.
query I con2
WITH s AS (FROM sirius_gateway_status()) SELECT count(*) FROM s WHERE state = 'up';
----
2

# A CTE that writes would do so on the gateway host.
statement error con2
WITH c AS (COPY (SELECT 1) TO '{TEST_DIR}/sirius_gateway_cte.csv') SELECT count(*) FROM sirius_gateway_status();
----
cannot write tables or files

# On the ranks, a SELECT with a CTE that writes changes state like any DML: it is logged for replay.
statement ok con2
WITH x AS (INSERT INTO t VALUES (-1) RETURNING k) SELECT * FROM x;

query I con2
SELECT count(*) FROM sirius_gateway_log() WHERE sql LIKE 'WITH x AS (INSERT%';
----
1

query I con2
SELECT count(*) FROM sirius_gateway_status() WHERE state = 'up';
----
2

# A plain SET on the console reaches the clients' sessions.
statement error con2
FROM sirius_gateway_drop_rank('nope');
----
can only be called on the gateway's console

statement ok
SET sirius_gateway_allow_join = true;

statement error con2
FROM sirius_gateway_drop_rank('nope');
----
no rank named nope was added

statement ok
SET sirius_gateway_allow_join = false;

statement ok con2
DISCONNECT;

# A start that its arguments refuse changes nothing: the ranks, their catalog and the log stay.
statement error
FROM sirius_gateway_start(2, gpus := '0', quack_base_port := 19500);
----
gpus lists 1 GPUs for 2 ranks

query I
SELECT count(*) FROM sirius_gateway_status() WHERE state = 'up' AND cluster = 'ready';
----
2

query I
FROM sirius_gateway_run('FROM v');
----
42

query I
SELECT count(*) > 0 FROM sirius_gateway_log();
----
true

# Nor the options that the next recovery starts the ranks with.
statement error
FROM sirius_gateway_start(2, gpus := '0', quack_base_port := 19500, replay_saved := true);
----
gpus lists 1 GPUs for 2 ranks

query T
SELECT state FROM sirius_gateway_test_signal(1, 9) WHERE rank = 1;
----
exited

query I
FROM sirius_gateway_run('FROM v');
----
42

# Ports are checked before anything stops.
statement error
FROM sirius_gateway_start(2, quack_base_port := 70000);
----
quack_base_port must be a port, 1 to 65535

statement error
FROM sirius_gateway_start(2, exchange_base_port := NULL);
----
exchange_base_port must be a port, 1 to 65535

statement error
FROM sirius_gateway_start(2, quack_base_port := 65535);
----
the base ports of 2 ranks must stay within 1 to 65535

statement error
FROM sirius_gateway_add_rank('127.0.0.1:95oo', exchange_port := 27000, token := 't');
----
is not host:port

statement error
FROM sirius_gateway_add_rank('127.0.0.1:70000', exchange_port := 27000, token := 't');
----
is not host:port

statement error
FROM sirius_gateway_add_rank('127.0.0.1:9500', exchange_port := 70000, token := 't');
----
exchange_port must be a port, 1 to 65535

statement error
FROM sirius_gateway_add_rank('127.0.0.1:9500', exchange_port := 27000, token := NULL);
----
token cannot be NULL

query I
SELECT count(*) FROM sirius_gateway_status() WHERE state = 'up' AND cluster = 'ready';
----
2

query I
SELECT state FROM sirius_gateway_stop();
----
stopped

statement error
FROM sirius_gateway_run('SELECT 1');
----
stopped
