# The environment of every run of the Reference numbers table, GDS and io_uring alike.
# SIRIUS_GDS=1 also binds each rank to the CPUs of its GPU's socket. bond0 is the interface the
# ranks of that cluster reach each other on; give --env UCX_NET_DEVICES=<yours> elsewhere.
SIRIUS_GDS=1
SIRIUS_PRIORITY_DOWNSTREAM_FIRST=1
UCX_TLS=cuda_copy,cuda_ipc,tcp,self
UCX_MODULES=^ib,rdmacm
UCX_NET_DEVICES=bond0
UCX_RCACHE_ENABLE=n
