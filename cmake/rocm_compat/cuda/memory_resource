//! @file
//! CCCL @c <cuda/memory_resource> redirect for ROCm.
//! Provides @c cuda::mr::any_resource and the @c cuda::mr::device_accessible /
//! @c cuda::mr::host_accessible property tags. Sirius uses these in
//! sirius_memory_reservation_manager.hpp and resource_ref_utils.hpp.
//!
//! This is a minimal stub: @c any_resource is aliased to
//! @c rmm::device_async_resource_ref (the type Sirius actually stores).
//! The property tags are empty structs used only for SFINAE/concept matching.

#pragma once

#include <rmm/resource_ref.hpp>

namespace cuda {
namespace mr {

/// Property tag: resource is accessible from the device.
struct device_accessible {};

/// Property tag: resource is accessible from the host.
struct host_accessible {};

/// Minimal any_resource — Sirius stores these in a vector and converts them
/// to rmm::device_async_resource_ref. The stub aliases to the RMM type.
using any_resource = rmm::device_async_resource_ref;

}  // namespace mr
}  // namespace cuda
