# Concatenate the NVRTC device runtime fragments
# (src/expression_evaluator/nvrtc/device_runtime/ *.cuh) into one C++ source
# that returns the text as a string view, so the generated kernels need no
# header tree on disk. Invoked via `cmake -P` from an add_custom_command.
#
# Inputs, passed with -D: FRAGMENTS is the ordered ;-list of fragment paths (the
# order is the dependency order) and OUT is the path of the .cpp to generate.
#
# Each fragment's leading license comment and `#pragma once` lines are dropped:
# the fragments are pasted into one translation unit, and NVRTC warns about
# `#pragma once` in a main file.

if(NOT FRAGMENTS OR NOT OUT)
  message(
    FATAL_ERROR "embed_nvrtc_device_runtime.cmake needs -DFRAGMENTS and -DOUT")
endif()

set(runtime "")
foreach(fragment IN LISTS FRAGMENTS)
  file(READ "${fragment}" contents)
  string(REPLACE "\r\n" "\n" contents "${contents}")
  # Drop the license block that opens every fragment.
  string(FIND "${contents}" "*/" license_end)
  if(contents MATCHES "^/\\*" AND NOT license_end EQUAL -1)
    math(EXPR after_license "${license_end} + 2")
    string(SUBSTRING "${contents}" ${after_license} -1 contents)
  endif()
  string(REGEX REPLACE "(^|\n)#pragma once[^\n]*" "\\1" contents "${contents}")
  string(STRIP "${contents}" contents)
  get_filename_component(name "${fragment}" NAME)
  string(APPEND runtime "// ---- ${name} ----\n${contents}\n\n")
endforeach()

# Raw-string delimiter chosen so it cannot appear in the embedded CUDA source.
set(D "SIRIUS_NVRTC_RT")

file(
  WRITE "${OUT}"
  "// AUTO-GENERATED by cmake/embed_nvrtc_device_runtime.cmake -- DO NOT EDIT.\n"
  "// The NVRTC device runtime fragments, concatenated in dependency order.\n"
  "#include <expression_evaluator/nvrtc/device_runtime.hpp>\n\n"
  "namespace sirius::nvrtc {\n\n"
  "std::string_view nvrtc_device_runtime_source() noexcept\n"
  "{\n"
  "  static constexpr char const text[] = R\"${D}(${runtime})${D}\";\n"
  "  return std::string_view{text, sizeof(text) - 1};\n"
  "}\n\n"
  "}  // namespace sirius::nvrtc\n")
