# Embeds the NVRTC device runtime
# (src/expression_evaluator/nvrtc/device_runtime/*.cuh) into the library as one
# string, generated by cmake/embed_nvrtc_device_runtime.cmake. Included from the
# root CMakeLists.txt because a target can only consume a custom command's
# output from the directory scope that defines it. The fragment order is the
# dependency order, read from the #include lines of device_runtime.cuh so the
# umbrella header (what nvcc checks) and the embedded string cannot diverge.
set(_nvrtc_device_runtime_dir
    "${PROJECT_SOURCE_DIR}/src/expression_evaluator/nvrtc/device_runtime")
set(_nvrtc_device_runtime_umbrella
    "${_nvrtc_device_runtime_dir}/device_runtime.cuh")
file(STRINGS "${_nvrtc_device_runtime_umbrella}" _nvrtc_device_runtime_includes
     REGEX "^#include \"[A-Za-z0-9_]+\\.cuh\"")
set(_nvrtc_device_runtime_fragments)
foreach(_line IN LISTS _nvrtc_device_runtime_includes)
  string(REGEX REPLACE "^#include \"([A-Za-z0-9_]+\\.cuh)\".*" "\\1" _fragment
                       "${_line}")
  list(APPEND _nvrtc_device_runtime_fragments
       "${_nvrtc_device_runtime_dir}/${_fragment}")
endforeach()
if(NOT _nvrtc_device_runtime_fragments)
  message(
    FATAL_ERROR
      "No device runtime fragments found in ${_nvrtc_device_runtime_umbrella}")
endif()
set_property(
  DIRECTORY
  APPEND
  PROPERTY CMAKE_CONFIGURE_DEPENDS "${_nvrtc_device_runtime_umbrella}")
set(_nvrtc_device_runtime_out
    "${PROJECT_BINARY_DIR}/generated/expression_evaluator/nvrtc/device_runtime_source.cpp"
)
add_custom_command(
  OUTPUT "${_nvrtc_device_runtime_out}"
  COMMAND
    ${CMAKE_COMMAND} "-DFRAGMENTS=${_nvrtc_device_runtime_fragments}"
    "-DOUT=${_nvrtc_device_runtime_out}" -P
    "${PROJECT_SOURCE_DIR}/cmake/embed_nvrtc_device_runtime.cmake"
  DEPENDS ${_nvrtc_device_runtime_fragments} "${_nvrtc_device_runtime_umbrella}"
          "${PROJECT_SOURCE_DIR}/cmake/embed_nvrtc_device_runtime.cmake"
  COMMENT "Embedding the NVRTC device runtime into ${_nvrtc_device_runtime_out}"
  VERBATIM)
target_sources(sirius_objects PRIVATE "${_nvrtc_device_runtime_out}")
