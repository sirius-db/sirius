{
  "buildPresets": [
    {
      "configurePreset": "debug",
      "name": "debug"
    },
    {
      "configurePreset": "release",
      "name": "release"
    },
    {
      "configurePreset": "relwithdebinfo",
      "name": "relwithdebinfo"
    },
    {
      "configurePreset": "clang-debug",
      "name": "clang-debug"
    },
    {
      "configurePreset": "clang-release",
      "name": "clang-release"
    },
    {
      "configurePreset": "clang-relwithdebinfo",
      "name": "clang-relwithdebinfo"
    },
    {
      "configurePreset": "legacy-release",
      "name": "legacy-release"
    },
    {
      "configurePreset": "vcpkg-debug",
      "name": "vcpkg-debug"
    },
    {
      "configurePreset": "vcpkg-release",
      "name": "vcpkg-release"
    },
    {
      "configurePreset": "vcpkg-relwithdebinfo",
      "name": "vcpkg-relwithdebinfo"
    },
    {
      "configurePreset": "ci-release",
      "name": "ci-release"
    }
  ],
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "cacheVariables": {
        "CMAKE_CUDA_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_LINKER_TYPE": "MOLD",
        "DUCKDB_EXTENSION_CONFIGS": "${sourceDir}/../extension_config.cmake",
        "EXPORT_DYNAMIC_SYMBOLS": "ON",
        "EXTENSION_STATIC_BUILD": "ON"
      },
      "generator": "Ninja",
      "hidden": true,
      "name": "base"
    },
    {
      "cacheVariables": {
        "CMAKE_CUDA_HOST_COMPILER": "$env{CONDA_PREFIX}/bin/clang++",
        "CMAKE_CXX_COMPILER": "$env{CONDA_PREFIX}/bin/clang++",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_C_COMPILER": "$env{CONDA_PREFIX}/bin/clang",
        "EXPORT_DYNAMIC_SYMBOLS": "OFF"
      },
      "hidden": true,
      "inherits": "base",
      "name": "base-clang"
    },
    {
      "binaryDir": "${sourceDir}/../build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CUDA_FLAGS_DEBUG": "-g -G -O0",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0",
        "CMAKE_C_FLAGS_DEBUG": "-g -O0"
      },
      "displayName": "GCC Debug",
      "inherits": "base",
      "name": "debug"
    },
    {
      "binaryDir": "${sourceDir}/../build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "displayName": "GCC Release",
      "inherits": "base",
      "name": "release"
    },
    {
      "binaryDir": "${sourceDir}/../build/relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "displayName": "GCC RelWithDebInfo",
      "inherits": "base",
      "name": "relwithdebinfo"
    },
    {
      "binaryDir": "${sourceDir}/../build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CUDA_FLAGS_DEBUG": "-g -G -O0",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0",
        "CMAKE_C_FLAGS_DEBUG": "-g -O0"
      },
      "displayName": "Clang Debug",
      "inherits": "base-clang",
      "name": "clang-debug"
    },
    {
      "binaryDir": "${sourceDir}/../build/clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "displayName": "Clang Release",
      "inherits": "base-clang",
      "name": "clang-release"
    },
    {
      "binaryDir": "${sourceDir}/../build/clang-relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "displayName": "Clang RelWithDebInfo",
      "inherits": "base-clang",
      "name": "clang-relwithdebinfo"
    },
    {
      "binaryDir": "${sourceDir}/../build/legacy-release",
      "cacheVariables": {
        "ENABLE_LEGACY_SIRIUS": "ON"
      },
      "inherits": "release",
      "name": "legacy-release"
    },
    {
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CPM_LOCAL_PACKAGES_ONLY": "ON",
        "VCPKG_BUILD": "ON",
        "VCPKG_INSTALL_OPTIONS": "--clean-buildtrees-after-build",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/.."
      },
      "environment": {
        "VCPKG_BUILD_TYPE": "release",
        "VCPKG_DISABLE_METRICS": "1",
        "VCPKG_LIBRARY_LINKAGE": "static"
      },
      "hidden": true,
      "inherits": "base",
      "name": "vcpkg-base"
    },
    {
      "binaryDir": "${sourceDir}/../build/vcpkg-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CUDA_FLAGS_DEBUG": "-g -G -O0",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0",
        "CMAKE_C_FLAGS_DEBUG": "-g -O0"
      },
      "displayName": "vcpkg Debug",
      "inherits": "vcpkg-base",
      "name": "vcpkg-debug"
    },
    {
      "binaryDir": "${sourceDir}/../build/vcpkg-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "displayName": "vcpkg Release",
      "inherits": "vcpkg-base",
      "name": "vcpkg-release"
    },
    {
      "binaryDir": "${sourceDir}/../build/vcpkg-relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "displayName": "vcpkg RelWithDebInfo",
      "inherits": "vcpkg-base",
      "name": "vcpkg-relwithdebinfo"
    },
    {
      "binaryDir": "${sourceDir}/../build/ci-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_LINKER_TYPE": "",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_TOOLCHAIN_PATH}"
      },
      "displayName": "CI Release (Docker vcpkg + ccache)",
      "inherits": "vcpkg-base",
      "name": "ci-release"
    }
  ],
  "version": 6
}
