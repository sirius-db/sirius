# engine-a.env -- Engine A (Sirius, 4 CNs / 4 GPUs) tunables for the 4x NVIDIA GB200 box.
#
#   source this file with bash, then source ../../scripts/cn-env.sh, then launch.
#   `cluster4-numa.sh` in this directory does exactly that.
#
# This is a BASH file (it defines arrays). Do not source it with sh/dash.
#
# This file is the WORKED EXAMPLE -- every value justified against this specific box.
# High-level knob list: ../../docs/TUNABLES.md. Transport knobs are range-validated
# at bring-up and REJECTED on a bad value, so a typo here fails CN startup.
#
# Every value below is either (a) measured on this box, or (b) derived from a measured value by
# arithmetic that is spelled out in the comment. Nothing here is a guess. The measured constants
# this file is built on:
#
#   usable HBM per GPU     188,416 MiB = 184.00 GiB   (nvidia-smi used+free; nameplate is 189,471
#                                                      MiB -- 1,055 MiB is driver/ECC reserve and
#                                                      is NOT available to you)
#   CUDA ctx + cuDF/RMM        779 MiB                (measured as device_used - pool - arena,
#                                                      confirmed on two CN generations 2 min apart)
#   LPDDR node 0           489,960 MiB = 478.48 GiB   (CPUs 0-71)
#   LPDDR node 1           489,823 MiB = 478.34 GiB   (CPUs 72-143)
#   CPU-addressable LPDDR  979,783 MiB = 956.82 GiB   <-- budget against THIS
#   mmfsd (GPFS daemon)     50.68 GiB permanent RSS
#   swap                        0                     <-- over-commit is an OOM-kill, not a slowdown
#
# WARNING: `free -g` reports ~1692 GiB on this box. That is WRONG for budgeting purposes -- the
# kernel counts the four 184 GiB GPU HBM NUMA nodes (2, 10, 18, 26) as system memory. Only 956.82
# GiB is CPU-addressable. Never size anything against `free`, `/proc/meminfo`, or a percentage.

# ---------------------------------------------------------------------------------------------
# Cluster shape
# ---------------------------------------------------------------------------------------------

# One CN per GPU. `nvidia-smi topo -m` shows NV18 between EVERY GPU pair (all-to-all full mesh,
# 18 bonded NVLinks, no PCIe/SYS hop between any two GPUs), so all 4 CNs are peers at equal cost
# and there is no reason to prefer a subset.
export NUM_CNS=${NUM_CNS:-4}

# Contiguous 10-port block per CN, same ladder as benchmarks/cluster8.sh, so the two launchers are
# interchangeable and the bench harness needs no change. Clear of the FE (8030/9010/9020/9030) and
# of the CN compiled-in defaults (9050/9060/8040/8060/9070). All CNs advertise 127.0.0.1 (there is
# no --advertise-host knob in the launcher), and the FE keys a node by (advertise_host,
# heartbeat_port) while the nixl agent is named {advertise_host}:{brpc_port} -- so the port block
# is the ONLY uniqueness lever between CNs. Do not overlap the blocks.
#
# Each CN consumes 5 consecutive ports (heartbeat/thrift/brpc/http/starlet), so PORT_STRIDE must
# be >= 5 or block i overlaps block i+1. cluster4-numa.sh refuses to start below 5.
export PORT_BASE=${PORT_BASE:-9100}
export PORT_STRIDE=${PORT_STRIDE:-10}

# ---------------------------------------------------------------------------------------------
# GPU memory  (SF100 defaults = the exact combination validated on this box)
# ---------------------------------------------------------------------------------------------
#
# Per-GPU arithmetic, against USABLE (184.00 GiB), not nameplate:
#
#     usable device                     188,416 MiB   184.00 GiB
#   - RMM pool          (GPU_MEM)       143,360 MiB   140.00 GiB   pre-reserved at startup
#   - staging arena     (STAGING)        16,384 MiB    16.00 GiB   OUTSIDE the pool -- see below
#   - CUDA ctx + cuDF/RMM                   779 MiB     0.76 GiB   measured
#   ---------------------------------------------------------
#     occupied                          160,523 MiB   156.76 GiB
#     headroom                           27,893 MiB    27.24 GiB   = 14.8% of usable
#
# The 27 GiB headroom is not slack you should spend. The consumers that live outside RMM's view
# all grow under load: per-kernel local-memory backing across 148 SMs, nvcomp scratch, and the
# cudaIpcOpenMemHandle page tables for 3 peers' arenas. Do not raise GPU_MEM + STAGING above
# 159,744 MiB total.
#
# CRITICAL: the staging arena is a bare cudaMalloc (src/exec/exchange_staging_arena.cpp:44), NOT
# pool memory. RMM knows nothing about it, so it does NOT come out of --gpu-memory-limit. Real
# per-GPU footprint is GPU_MEM + STAGING + 779 MiB. Budget the sum, never GPU_MEM alone.
# It must stay a plain cudaMalloc by contract -- pool memory silently loses the cuda_ipc fast path.
export GPU_MEM=${GPU_MEM:-140GiB}
export STAGING=${STAGING:-16GiB}

# OPTIONAL, FOOTPRINT-NEUTRAL REBALANCE (not yet validated -- uncomment to test):
#   132 GiB pool + 24 GiB arena = 135,168 + 24,576 = 159,744 MiB -- IDENTICAL total, IDENTICAL
#   27,893 MiB headroom. It moves 8 GiB from the over-provisioned side to the tight side:
#     - the pool is ~7x over-provisioned at SF100 (measured per-CN peaks are 15-20 GiB: q17
#       canonical sort ~9 GB, q18 build+hash 8 GB, staged inbound 1.9-6 GB) vs a 140 GiB pool;
#     - the arena is the tighter of the two. CORRECTION to an earlier draft of this file: the
#       allocator is NOT a pure monotonic bump arena. exchange_staging_arena.cpp:105-115 implements
#       TRAILING reclamation -- on release the bump head drops back to the end of the highest
#       still-outstanding lease, and to 0 when none remain. So steady-state demand is peak
#       CONCURRENT (in-flight) bytes, not cumulative-per-epoch, and it is materially below the
#       10-12 GB/CN cumulative figure. 16 GiB is therefore comfortable in the common case; what it
#       does not cover is the pathological case that trailing reclamation cannot help -- one
#       long-lived low-offset lease pinning the head while later leases pile up above it.
#   The arena fails HARD ("exchange staging arena exhausted ... raise SIRIUS_EXCHANGE_STAGING_BYTES",
#   exchange_staging_arena.cpp:86); it does not degrade. That failure mode, not a headline margin
#   number, is why 24 GiB is worth testing -- treat the arena as a *candidate* contributor to the
#   q05 wedge, not the leading hypothesis. Cheap to test because it is footprint-neutral.
# export GPU_MEM=132GiB
# export STAGING=24GiB

# ---- SF1000 ----------------------------------------------------------------------------------
#   131,072 (128 GiB pool) + 32,768 (32 GiB arena) + 779 (measured CUDA ctx + cuDF/RMM) = 164,619
#   headroom = 188,416 - 164,619 = 23,797 MiB = 23.24 GiB = 12.6%
#   (uses the SAME measured 779 MiB constant as the SF100 block above -- an earlier draft used an
#   unexplained 2,048 MiB here, which made the two blocks incomparable.)
# HONEST CAVEAT: you cannot buy SF1000 with this knob. Projected per-CN peaks put q21 at 100-150
# GB and SF1000 arena demand at 105-125 GB/CN under the current bump-reset policy -- no fixed slab
# coexists with that. Eager per-lease arena reclaim (roadmap M2 phase 2) is a HARD PREREQUISITE,
# after which in-flight demand is low-GB and 32 GiB is generous.
# export GPU_MEM=128GiB
# export STAGING=32GiB

# cluster8.sh resolves SIRIUS_EXCHANGE_STAGING_BYTES as ${SIRIUS_EXCHANGE_STAGING_BYTES:-$STAGING},
# i.e. an explicitly exported value beats STAGING. Set it here so that sourcing this file alone is
# sufficient, and so the two names can never drift apart.
#
# If this is UNSET the CN builds NO arena at all: build_nixl_transport returns Ok(None) and every
# remote exchange then errors out. A 4-CN cluster with no arena is a 4-CN cluster that cannot
# shuffle. It must always be set.
export SIRIUS_EXCHANGE_STAGING_BYTES="${SIRIUS_EXCHANGE_STAGING_BYTES:-$STAGING}"

# ---------------------------------------------------------------------------------------------
# Host memory  -- and the explicit resolution of the OPEN-ISSUES M1 item 3 conflict
# ---------------------------------------------------------------------------------------------
#
# THE CONFLICT: M1 item 3 asks for 160-200 GiB/CN AND for ">=400 GB of LPDDR left for page cache".
# At 4 CNs those two asks are stated as if both were scale-independent constants. They are not,
# and at 200 GiB/CN they are arithmetically impossible:
#
#     4 x 200 GiB = 800 + 84 (fixed tenants) = 884 of 956.82 GiB  ->  only 72.8 GiB left.
#
# ---- THE TWO CONVENTIONS THIS BUDGET AND engine-b/ BOTH USE (they must never diverge) ----
#
# (1) WHICH "GB". The box brief states total LPDDR as "~980 GB", which is 979,783 MiB / 1000 --
#     i.e. the unit in play is MiB/1000, not GiB and not decimal GB. Read consistently, M1's
#     ">=400 GB" bar is 400,000 MiB = 390.625 GiB. That is the STRICTEST of the plausible readings
#     (decimal 400 GB is only 372.5 GiB), so it is the one both arms are validated against.
#     *** Do not re-score this bar in decimal GB. An earlier draft did, and passed SF1000 at
#     372.82 GiB -- which MISSES the real bar by 17.8 GiB. ***
#
# (2) FIXED TENANTS = 84 GiB, and a 32 GiB margin, IDENTICAL in both arms:
#         mmfsd (GPFS daemon)          50.68 GiB   measured, permanent RSS
#         FE JVM                       ~20.00 GiB   see note below
#         kernel, slab, daemons        ~13.00 GiB
#         ------------------------------------
#         total                        ~84 GiB
#     The FE JVM is charged at 20 GiB in BOTH arms even though engine A's FE is -Xmx8192m (~10 GiB)
#     and only engine B's is -Xmx16g (~20 GiB). Charging the larger figure to both keeps ONE tenant
#     constant across the comparison; it is deliberately conservative for A. The 32 GiB margin is
#     not padding -- swap is 0, so an over-commit is an OOM-kill mid-sweep, and it too is applied
#     to both arms. Mixing conventions between the arms silently hands one engine more page cache
#     than the other, which is a wrong-benchmark condition.
#
# RESOLUTION OF THE CONFLICT: page-cache demand is a FUNCTION OF DATASET SIZE; the host limit is
# the residual, not a constant. Measured (du -sb):
#         SF100    27,679,674,924 B  =  25.78 GiB
#         SF1000  284,000,396,268 B  = 264.50 GiB   (= 284.0 GB decimal; `du -sh` prints "265G",
#                                                    which is GiB -- an earlier draft mis-read that
#                                                    as decimal GB and got 246.8 GiB, and another
#                                                    guessed 363 GiB. Both are replaced by this
#                                                    measurement.)
#
#     HOST_MEM = (956.82 - 84 fixed - 32 margin - required page cache) / NUM_CNS
#
# SF100 -> 160GiB.  *** THE >=400 GB BAR IS EXPLICITLY WAIVED AT SF100, IN BOTH ARMS. ***
#     It is vacuous: the dataset is 25.78 GiB, so no sizing choice can fill 390.6 GiB of page
#     cache. Enforcing it here would only shrink a limit nothing is using. engine-b/README.md
#     states the identical waiver, so the two arms give the SAME answer to the same requirement.
#     global   4 x 160 = 640;  956.82 - 84 - 640 = 232.82 GiB residual
#              232.82 - 32 margin = 200.82 GiB page cache = 7.8x the 25.78 GiB dataset  OK
#              (engine B commits 480 GiB at SF100 and leaves 360.82 GiB. Both arms cache the whole
#              dataset many times over, so this asymmetry cannot bias the SF100 result. At SF1000,
#              where cache IS first-order, the two arms are sized to commit exactly the same
#              448 GiB -- see below.)
#     per-node see the ceiling derivation below.
#
# WHY 160 AND NOT THE VALIDATED 200: because THIS launcher adds a hard --membind, which the
# validated run did not have. Under a hard membind the binding constraint becomes PER-NODE, and
# a CN that exceeds its node's LPDDR is OOM-killed rather than falling back to the other socket.
# Worst-case per-node ceiling on node 1 (478.34 GiB, 2 CNs), every term labelled:
#
#       478.34   node 1 LPDDR
#     -  50.68   mmfsd, charged IN FULL to one node. It is a single unpinned process under
#                default local-alloc, so its ~50 GiB follows whichever socket its threads run
#                on and may land almost entirely on one node. The per-node tables elsewhere
#                that split it ~25/25 are the OPTIMISTIC case; this ceiling is the pessimistic
#                one, which is the correct side to size a hard cap from.
#     -  20.00   FE JVM (unpinned but membound to the CPU nodes, so it may land here)
#     -   5.00   kernel/slab/daemons share of this node
#     -  16.00   per-node margin (zero swap)
#       ------
#       386.66 / 2 CNs  =  193.33 GiB per CN
#
# So the validated 200 GiB/CN EXCEEDS the per-node ceiling under a hard membind -- it is safe today
# only because the live CNs are unpinned and can spill across sockets. 160 GiB costs nothing to
# give up: the host limit is a lazily-grown CEILING, not a reservation -- measured CN host RSS at
# rest is 1.0-1.5 GiB against a 200 GiB limit, and host spillability is not implemented yet, so the
# host pool is barely used. 160 GiB is still ~8-10x any plausible SF100 demand, and it satisfies
# M1's "160-200 GiB/CN" ask (which is only satisfiable at SF100 at all).
#
# To reproduce the exactly-as-validated run (unpinned semantics), set CPU_SPLIT=none AND
# HOST_MEM=200GiB. Do not raise HOST_MEM above 193 GiB while membind is active.
export HOST_MEM=${HOST_MEM:-160GiB}

# ---- SF1000 ---- here the ">=400 GB cache" ask is real, binding, and it WINS:
#     required page cache = 390.625 GiB (convention 1 above)
#     4H <= 956.82 - 84 - 32 - 390.625 = 450.195  ->  H <= 112.5 GiB
#     at H = 112:  4 x 112 = 448;  956.82 - 84 - 448 = 424.82 GiB residual
#                  424.82 - 32 margin = 392.82 GiB page cache >= 390.625        OK (+2.2 GiB)
#                  392.82 >= the 264.50 GiB dataset, so a warm pass caches all of it (1.49x)
#     per-node    2 x 112 = 224;  224 + 50.68 + 20 + 5 = 299.68 of 478.34  ->  178.7 GiB slack OK
#
#     *** 112 GiB/CN is chosen so that 4 x 112 = 448 GiB is EXACTLY engine B's 2 x 224 = 448 GiB.
#     Both arms then commit the same LPDDR and leave the same 392.82 GiB of page cache at the
#     scale where page cache is a first-order effect. 120 GiB/CN would commit 480 and leave only
#     372.82 GiB -- below the bar, and 52 GiB less cache than the CPU baseline gets. ***
#
# The host limit yields and the cache does not, because the limit is an unused ceiling while page
# cache is the difference between a cold and a warm scan of a 264.5 GiB dataset -- a first-order
# effect on the headline number, amplified further while the dataset sits on network storage.
# export HOST_MEM=112GiB

# NOTE on units: --host-memory-limit lands on memory.host.capacity_bytes, which the config schema
# documents as PER NUMA NODE. On this box that reading does not bite -- the CN log confirms
# "1 host memory space(s) created for 34 NUMA node(s)" -- so HOST_MEM is a PER-CN TOTAL.
# Re-check that log line if the engine's host-space policy ever changes.

# ---------------------------------------------------------------------------------------------
# Query watchdog
# ---------------------------------------------------------------------------------------------
#
# 0 = OFF (plain blocking future.get()) and is the compiled default. cluster8.sh never sets this,
# so 0 is the exact behaviour of the validated run -- which is why it is the default here.
#
# When > 0 the engine polls every 250 ms and, after N seconds with NO CHANGE in the
# scheduling-progress fingerprint, fails the query loudly instead of leaving a SIGTERM-resistant
# head-of-line stall. It is progress-based, not wall-clock-based, so a long query that keeps making
# progress does not trip it; a single kernel that legitimately runs longer than N does.
#
# RECOMMENDED FOR UNATTENDED SWEEPS: 120. q05 and q09 currently WEDGE at the harness's 180 s
# timeout, and the client timing out does not unwedge the CN -- it stays poisoned for every
# subsequent query, so one wedge silently corrupts the rest of the sweep. 120 fires before the
# 180 s harness timeout and converts the wedge into a clean query error. The margin is ~13x over
# the slowest PASSING SF100 query (q07 at 8.9 s), so false positives are unlikely at this scale.
# Left off by default so the baseline number is the validated one; turn it on for long sweeps.
export SIRIUS_QUERY_WATCHDOG_SECS=${SIRIUS_QUERY_WATCHDOG_SECS:-0}
# export SIRIUS_QUERY_WATCHDOG_SECS=120     # SF100 unattended sweep
# export SIRIUS_QUERY_WATCHDOG_SECS=300     # SF1000 -- stages are legitimately much longer

# ---------------------------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------------------------
#
# cuda_copy lets UCX detect VRAM pointers; cuda_ipc is the same-host GPU-to-GPU path and rides the
# NV18 mesh directly. Without cuda_ipc every transfer takes a ~200x slower host bounce.
# MEASURED HERE: the nixl first-contact bandwidth canary reported 322-399 GB/s per peer against a
# 2.0 GB/s floor -- that is cuda_ipc over NVLink, confirmed. Below the floor the tier is REFUSED,
# not degraded, so a misconfigured UCX_TLS fails the cluster loudly at bring-up.
#
# DO NOT add rc/ud/ib/rdma here. All 8 mlx5 NICs are "SYS" from every GPU (no PCIe locality to any
# GPU) and this box is single-node, so the nixl RDMA tier is not used and the NICs are idle.
# Adding an IB transport can only cost you: UCX may select it over cuda_ipc and turn a 350 GB/s
# NVLink hop into a loopback-through-the-fabric hop.
export UCX_TLS=${UCX_TLS:-cuda_copy,cuda_ipc,tcp,self}

# ---------------------------------------------------------------------------------------------
# Toolchain / paths
# ---------------------------------------------------------------------------------------------

# Out-of-tree nixl + UCX installs. This is the same value cn-env.sh derives by default (a `tools/`
# dir next to the repo root); pinned explicitly so the config does not depend on where the repo
# happens to be cloned. cn-env.sh hard-fails if $TOOLS_DIR/nvda_nixl/lib is absent, and sets
# NIXL_NO_STUBS_FALLBACK=1 so a broken nixl link cannot silently degrade to a dlopen stub.
export TOOLS_DIR=${TOOLS_DIR:-/home/prestouser/aocsa/tools}

# The FE requires JDK >= 17 (MIN_JDK_VERSION=17 in start_fe.sh) and hard-uses $JAVA_HOME/bin/java.
#
# HONEST STATUS: this pin is currently REDUNDANT, not a fix. If JAVA_HOME is unset, start_fe.sh
# (:116-127) infers it from `javac` first and only then from `java` -- but this box has NO javac on
# PATH (`command -v javac` exits 1), so the inference always falls through to the `java` branch,
# and `readlink -f /usr/bin/java` resolves to exactly the value below. The inference is already
# deterministic and already correct. The pin is kept because it makes the FE's JDK an explicit,
# reviewable part of the config rather than a property of $PATH -- installing a JDK 8/11 `javac`
# (several JDKs are present under /usr/lib/jvm) would flip the inference to the javac branch and
# abort the FE with "JDK 8 is not supported".
#
# Verified: OpenJDK 21.0.5. That tree is JRE-only -- it has no bin/javac -- which is fine, because
# start_fe.sh:147 only ever invokes $JAVA_HOME/bin/java.
export JAVA_HOME=${JAVA_HOME:-/usr/lib/jvm/java-21-openjdk-arm64}

# CUDA 13.0, driver 580.105.08. /usr/local/cuda is a symlink via /etc/alternatives/cuda.
export CUDA_HOME=${CUDA_HOME:-/usr/local/cuda}

# CN-side tracing filter. The compiled fallback is "sirius_starrocks_cn=info,info". Raise only for
# triage -- debug level on 4 CNs writes a lot to $engine_dir/log.
export RUST_LOG=${RUST_LOG:-sirius_starrocks_cn=info,info}

# ---------------------------------------------------------------------------------------------
# NUMA placement
# ---------------------------------------------------------------------------------------------
#
# From `nvidia-smi topo -m`:  GPU0,GPU1 -> CPU affinity 0-71  -> socket/NUMA node 0
#                             GPU2,GPU3 -> CPU affinity 72-143 -> socket/NUMA node 1
#
# ############################################################################################
# # DANGER: --membind is ONLY ever 0 or 1.                                                    #
# # NUMA nodes 2, 10, 18 and 26 have ZERO CPUs and 188,416 MB each -- they ARE the four GPUs'  #
# # HBM. Binding host memory to one of them consumes the HBM of a GPU a CN is computing on.    #
# # Never --interleave=all (spreads the CN heap across all four HBM nodes).                    #
# # Never --preferred=N (soft: leaves the HBM nodes in Mems_allowed_list -- the exact failure  #
# # you are trying to exclude). Only hard --membind does the job.                              #
# # cluster4-numa.sh enforces this: it refuses to start if a configured node has no CPUs.      #
# ############################################################################################
#
# WHAT THE membind IS AND IS NOT BUYING -- corrected, because an earlier draft of this file
# justified it with a claim that does not survive measurement:
#
#   RETRACTED: "node 2's free memory tracks nvidia-smi's free memory for GPU0 exactly."
#   Measured with 4 CNs live: `numactl --hardware` reported node 2 free = 188,386 MB while
#   nvidia-smi reported GPU0 used = 160,496 MiB / free = 27,921 MiB -- a ~160 GiB disagreement,
#   exactly the RMM pool. The two counters coincide ONLY at idle (both 188,389 MiB with the GPUs
#   idle), because the kernel's NUMA free counter does not account for driver device allocations
#   at all. It therefore can never be evidence that host pages are landing in HBM.
#
#   ALSO TRUE, IN THE OTHER DIRECTION: the engine's own NUMA-explicit host allocator already
#   targets a CPU node without any help from numactl. numa_region_pinned_host_allocator.cpp:60
#   calls numa_alloc_onnode(bytes, _numa_node), where _numa_node comes from use_host_per_numa()
#   -> bind_cpu_to_gpu_numa -> gpu.numa_id, derived from nvmlDeviceGetMemoryAffinity(...,
#   NVML_AFFINITY_SCOPE_NODE) (topology_discovery.cpp:269-277). The live CN log confirms the
#   result: "GPU 0: NVIDIA GB200 (numa=0, ...)". CN_NODE="0 0 1 1" below is exactly what the
#   engine derives for itself -- the membind agrees with the engine rather than overriding it.
#
#   SO WHY membind AT ALL? Defence in depth over everything that does NOT go through that
#   allocator, all of which today runs with Mems_allowed_list = "0-2,10,18,26": the glibc heap,
#   ~480 thread stacks, Rust/jemalloc arenas, the JNI/JVM side, and any mmap the CN or its
#   dependencies take. None of those are NUMA-aware, and any of them may allocate from an HBM node
#   under memory pressure. It is a cheap, mechanical interlock -- not a tuning knob, and not
#   (as previously claimed) a fix for an observed leak into HBM.
#
# CPU_SPLIT presets. The mechanism that makes this a BENCHMARK-VALIDITY knob and not just a
# placement knob: experimental/starrocks/src/lib.rs:357 sends std::thread::available_parallelism()
# to the FE as num_hardware_cores, and Rust's available_parallelism() honours sched_getaffinity --
# so --physcpubind DIRECTLY changes the number of cores the FE thinks this box has, and hence
# pipeline_dop = min(max_pipeline_dop=64, avgNumCoresOfBe/2).
#
#   "disjoint"  (DEFAULT)
#             0-35 / 36-71 / 72-107 / 108-143, no sharing. Sum reported to the FE = 4 x 36 = 144,
#             the TRUE core count of this box.
#             *** THIS IS THE DEFAULT BECAUSE OF THE A/B COMPARISON, NOT BECAUSE OF PLACEMENT. ***
#             Engine B is deliberately forced into truthful core accounting (be1.conf/be2.conf set
#             num_cores = 72 and enable_resource_group_bind_cpus = false, because StarRocks'
#             CpuInfo never calls sched_getaffinity and would otherwise report 144 per BE). If
#             engine A simultaneously over-reported its cores, the two planners would be handicapped
#             differently and the headline number would not be a comparison. engine-b/README.md
#             states the experiment as "A gets 4 procs x 36 cores, B gets 2 procs x 72 cores --
#             both 144"; "disjoint" is what makes that statement true.
#             Independently, over-reporting is also the wrong direction on the merits: it inflates
#             fragment-instance count -> more, SMALLER batches -> more exchange RPCs, and the single
#             blocking transport thread per CN is already the dominant cost at scale. CPU is not the
#             bottleneck here (parquet decode is on-GPU in cuDF; CN RSS at rest is 1.0-1.5 GiB with
#             ~480 mostly-blocked threads), so a 36-core mask does not throttle scan fan-out.
#
#   "socket"  CN0,CN1 share 0-71; CN2,CN3 share 72-143. This is what OPEN-ISSUES M1 specifies and
#             it is the closer of the two to the (unpinned) validated run in placement terms, but
#             it reports 4 x 72 = 288 cores -- still 2x over -- so it BREAKS the equal-accounting
#             property above. Use it as a sensitivity run, and if you publish a number from it, say
#             so. The nominal argument for it -- CN0 borrows CN1's idle cores -- is weak: all four
#             CNs execute the same pipeline stage of the same fragment concurrently, so their CPU
#             demand peaks are correlated, not anti-correlated.
#
#   "none"    No numactl at all. Reproduces the exactly-validated run (which reported 4 x 144 = 576
#             cores). If you use this, also set HOST_MEM=200GiB -- and accept that the HBM nodes
#             stay in Mems_allowed_list for the CNs AND the FE.
#
# Fallback rule: if `vmstat 1` shows a sustained run-queue > 36 per socket during a sweep, move
# from "disjoint" to "socket" AND pin `SET GLOBAL pipeline_dop` explicitly, so that the core-count
# over-report stops mattering.
export CPU_SPLIT=${CPU_SPLIT:-disjoint}

# Per-CN GPU index. CN i -> GPU i. Passed as --gpu-device, which the CN turns into
# CUDA_VISIBLE_DEVICES. NOTE: an already-exported CUDA_VISIBLE_DEVICES WINS and --gpu-device is
# only warned about -- which would land all 4 CNs on one GPU. cluster4-numa.sh unsets it.
export CN_GPU="0 1 2 3"

# Per-CN NUMA node, index-aligned with CN_GPU. Derived from the GPU CPU-affinity column above.
# ONLY 0 AND 1 ARE EVER VALID (see the DANGER box).
export CN_NODE="0 0 1 1"

# Per-CN cpubind list, index-aligned with CN_GPU. Must be a subset of its node's CPUs;
# cluster4-numa.sh verifies this against `numactl --hardware` and refuses to start otherwise.
case "$CPU_SPLIT" in
    socket)   export CN_CPUS="0-71 0-71 72-143 72-143" ;;
    disjoint) export CN_CPUS="0-35 36-71 72-107 108-143" ;;
    none)     export CN_CPUS="" ;;
    *) echo "engine-a.env: CPU_SPLIT must be socket|disjoint|none, got '$CPU_SPLIT'" >&2
       return 1 2>/dev/null || exit 1 ;;
esac

# The FE is deliberately left CPU-UNPINNED. It is an ~8 GiB-heap JVM coordinator and it is the only
# process left that can float across both sockets once all 4 CNs are hard-membound; that float is
# what absorbs a bad estimate in the ~84 GiB fixed-tenant budget.
#
# It is NOT left memory-unpinned. cluster4-numa.sh launches it under `numactl --membind=<every
# CPU-bearing node>` with no cpubind: the float is fully preserved (both sockets stay allowed)
# while the HBM nodes are excluded. A bare FE would sit at Mems_allowed_list = "0-2,10,18,26" --
# a ~10-20 GiB JVM able to allocate into GPU0's 27.24 GiB of headroom, which is the one exposure
# the CN membind exists to close.
#
# PIN_FE=1 additionally cpubinds the FE to CN0's socket, which DESTROYS the float described above.
# It is strictly more restrictive than the default; set it only for a specific experiment.
export PIN_FE=${PIN_FE:-0}
