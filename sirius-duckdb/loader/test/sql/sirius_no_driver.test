# name: test/sql/sirius_no_driver.test
# description: Without an NVIDIA driver, sirius loads and leaves queries to DuckDB's CPU engine
# group: [sirius]
# Assumes no usable NVIDIA driver, as on DuckDB's CI runners.

require sirius

statement ok
LOAD sirius;

query I
SELECT sum(i) FROM range(1000000) t(i);
----
499999500000

query IIIIII
SELECT driver_found, cuda_driver_version, backend, backend_loaded, gpu_execution,
       fallback_reason LIKE 'Sirius requires an NVIDIA driver supporting CUDA 12 or newer: %'
FROM sirius_status();
----
false	NULL	NULL	false	false	true

query I
SELECT current_setting('gpu_execution');
----
false

statement ok
SET gpu_execution = false;

statement error
SET gpu_execution = true;
----
Sirius requires an NVIDIA driver supporting CUDA 12 or newer

statement error
SET GLOBAL gpu_execution = true;
----
Sirius requires an NVIDIA driver supporting CUDA 12 or newer

# A refused SET leaves the setting off.
query I
SELECT current_setting('gpu_execution');
----
false

statement ok
RESET gpu_execution;

statement error
SELECT * FROM gpu_execution('SELECT 42');
----
Sirius requires an NVIDIA driver supporting CUDA 12 or newer

statement error
SELECT * FROM gpu_execution('SELECT 42', enable_optimizer => false);
----
Sirius requires an NVIDIA driver supporting CUDA 12 or newer

query I
SELECT count(*) FROM range(10) t(i) WHERE i % 2 = 0;
----
5
