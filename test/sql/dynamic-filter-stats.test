# name: test/sql/dynamic-filter-stats.test
# description: Smoke test for the sirius_dynamic_filter_stats() table function: one (name, value)
#              row per dynamic_filter_stats_snapshot counter. The expected count must equal
#              dynamic_filter_stats_field_count in src/include/op/dynamic_filter/
#              dynamic_filter_stats.hpp; the Catch2 test tagged [dynamic_filter_stats] pins the
#              full field set and value equality against an in-process snapshot.
# group: [sirius]

require sirius

query I
SELECT count(*) FROM sirius_dynamic_filter_stats();
----
50

# Counters are monotonic uint64 values; a NULL name or value would mean a field fell out of the
# enumeration half-emitted.
query I
SELECT count(*) FROM sirius_dynamic_filter_stats() WHERE name IS NULL OR value IS NULL;
----
0
