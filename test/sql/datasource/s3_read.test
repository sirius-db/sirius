# name: test/sql/datasource/s3_read.test
# description: End-to-end read_parquet against a local MinIO.
# group: [sirius]
#
# DISABLED: this test requires a valid parquet fixture at
# s3://sirius-test/small.parquet. The stdlib-only generate_fixtures.py now
# writes opaque deterministic binary blobs (small.bin / medium.bin) instead of
# real parquet, so read_parquet() cannot parse the object. Re-enable once a
# stdlib-only (or optional pyarrow/duckdb) parquet generator is wired back in.
#
# The previous query set is preserved below for reference; `mode skip` causes
# the SQLLogicTest runner to skip every statement in this file.

mode skip

require sirius

require parquet

statement ok
SET s3_endpoint = 'http://127.0.0.1:9000';

statement ok
SET s3_region = 'us-east-1';

statement ok
SET s3_access_key = 'minioadmin';

statement ok
SET s3_secret_key = 'minioadmin';

query I
SELECT COUNT(*) FROM read_parquet('s3://sirius-test/small.parquet');
----
256

query II
SELECT MIN(id), MAX(id) FROM read_parquet('s3://sirius-test/small.parquet');
----
0	255

query I
SELECT MAX(v) FROM read_parquet('s3://sirius-test/small.parquet');
----
2019345
