# name: test/sql/datasource/s3_read.test
# description: End-to-end read_parquet against a local MinIO (see
#              test/integration/s3/docker-compose.yml).
# group: [sirius]
#
# Prerequisites (all driven by `make s3-up`):
#   - MinIO running at http://127.0.0.1:9000 with minioadmin/minioadmin
#   - bucket sirius-test populated with small.parquet + hello.txt
#
# Run with:
#   source test/integration/s3/env.sh
#   build/release/test/unittest --test-dir . test/sql/datasource/s3_read.test
#
# Skipped unless the S3 extension can reach the endpoint.

require sirius

require parquet

# Point Sirius at the local MinIO. These SETs exercise the same plumbing as
# test/sql/datasource/set_s3_transport.test but with values the backend
# actually uses to authenticate.
statement ok
SET s3_endpoint = 'http://127.0.0.1:9000';

statement ok
SET s3_region = 'us-east-1';

statement ok
SET s3_access_key = 'minioadmin';

statement ok
SET s3_secret_key = 'minioadmin';

# Golden path: the small.parquet fixture has 256 rows.
query I
SELECT COUNT(*) FROM read_parquet('s3://sirius-test/small.parquet');
----
256

# First and last id values: the fixture is generated by
# `range(256)` so id is [0, 255].
query II
SELECT MIN(id), MAX(id) FROM read_parquet('s3://sirius-test/small.parquet');
----
0	255

# v = id * 7919; the largest v is therefore 255*7919 = 2019345.
query I
SELECT MAX(v) FROM read_parquet('s3://sirius-test/small.parquet');
----
2019345
