# name: test/sql/datasource/s3_debug_size.test
# description: End-to-end HEAD probe against a local MinIO through the new
#              Sirius S3 IO pipeline. The sirius_debug_datasource_size()
#              table function resolves its URI via datasource_factory, which
#              looks up the s3_ioctx that SET s3_endpoint / s3_access_key /
#              ... registered on the per-connection sirius_config. This is
#              the shortest path from SQL through SigV4 + libcurl to MinIO
#              and back, without involving DuckDB's own httpfs.
# group: [sirius]
#
# Prerequisites (all handled by `make s3-up`):
#   - MinIO reachable at http://127.0.0.1:9000 with minioadmin/minioadmin
#   - bucket sirius-test populated with hello.txt, small.bin, medium.bin
#
# Run:
#   source test/integration/s3/env.sh
#   build/release/test/unittest --test-dir . test/sql/datasource/s3_debug_size.test
#
# Not wired into `make test` because SQLLogicTests there run the legacy
# gpu_processing path and require live MinIO that CI runners may not have.

require sirius

# SET routes through object_store_config on the SiriusContext attached to
# this connection. The debug table function reads the same config when it
# constructs its local registry, so these four SETs are what wires the
# subsequent `sirius_debug_datasource_size('s3://...')` call to MinIO.
statement ok
SET s3_endpoint = 'http://127.0.0.1:9000';

statement ok
SET s3_region = 'us-east-1';

statement ok
SET s3_access_key = 'minioadmin';

statement ok
SET s3_secret_key = 'minioadmin';

# hello.txt — 16-byte ASCII blob. Exercises HEAD + VARCHAR return path.
query I
SELECT size FROM sirius_debug_datasource_size('s3://sirius-test/hello.txt');
----
16

# small.bin — 20 KiB deterministic blob generated by generate_fixtures.py.
query I
SELECT size FROM sirius_debug_datasource_size('s3://sirius-test/small.bin');
----
20480

# medium.bin — 8 MiB deterministic blob; confirms large objects HEAD cleanly.
query I
SELECT size FROM sirius_debug_datasource_size('s3://sirius-test/medium.bin');
----
8388608

# Missing key: the s3_ioctx surfaces a 404 as std::runtime_error, which the
# table function rethrows as a DuckDB InvalidInputException. `statement error`
# only needs the error to propagate — we don't pin to a specific message so
# the test stays stable across SigV4 / libcurl wording changes.
statement error
SELECT size FROM sirius_debug_datasource_size('s3://sirius-test/does-not-exist.bin');
----
