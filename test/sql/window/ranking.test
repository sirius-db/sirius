# name: test/sql/window/ranking.test
# description: Window ranking semantics through gpu_execution
# group: [sirius]

require sirius

statement ok
call gpu_buffer_init("1 GB", "2 GB");

statement ok
SET enable_duckdb_fallback = false;

statement ok
DROP TABLE IF EXISTS window_rank_input;

statement ok
CREATE TABLE window_rank_input
(
    grp INTEGER,
    subgroup INTEGER,
    metric INTEGER,
    id INTEGER
);

statement ok
INSERT INTO window_rank_input VALUES
    (1, 10, 100, 1),
    (1, 10, 100, 2),
    (1, 10,  80, 3),
    (1, 20,  70, 4),
    (2, 10,  50, 5),
    (2, 10,  50, 6),
    (2, 20, NULL, 7),
    (NULL, 10, 40, 8),
    (NULL, 10, 30, 9);

query III
CALL gpu_execution("SELECT coalesce(grp, -1) AS grp_key, id, rn FROM (SELECT grp, id, row_number() OVER (PARTITION BY grp ORDER BY metric DESC NULLS LAST, id ASC) AS rn FROM window_rank_input) ranked ORDER BY grp_key, rn, id;");
----
-1 8 1
-1 9 2
1 1 1
1 2 2
1 3 3
1 4 4
2 5 1
2 6 2
2 7 3

query IIII
CALL gpu_execution("SELECT id, rnk, dr, rn FROM (SELECT id, rank() OVER (PARTITION BY grp ORDER BY metric DESC NULLS LAST) AS rnk, dense_rank() OVER (PARTITION BY grp ORDER BY metric DESC NULLS LAST) AS dr, row_number() OVER (PARTITION BY grp ORDER BY metric DESC NULLS LAST, id ASC) AS rn FROM window_rank_input WHERE grp = 1) ranked ORDER BY id;");
----
1 1 1 1
2 1 1 2
3 3 2 3
4 4 3 4

query III
CALL gpu_execution("SELECT id, rnk, dr FROM (SELECT id, rank() OVER (PARTITION BY grp ORDER BY metric ASC NULLS FIRST) AS rnk, dense_rank() OVER (PARTITION BY grp ORDER BY metric ASC NULLS FIRST) AS dr FROM window_rank_input WHERE grp = 2) ranked ORDER BY id;");
----
5 2 2
6 2 2
7 1 1

query IIII
CALL gpu_execution("SELECT grp, subgroup, id, rn FROM (SELECT grp, subgroup, id, row_number() OVER (PARTITION BY grp, subgroup ORDER BY metric DESC NULLS LAST, id DESC) AS rn FROM window_rank_input WHERE grp IS NOT NULL) ranked ORDER BY grp, subgroup, rn;");
----
1 10 2 1
1 10 1 2
1 10 3 3
1 20 4 1
2 10 6 1
2 10 5 2
2 20 7 1

query III
CALL gpu_execution("SELECT id, rnk, dr FROM (SELECT id, rank() OVER (PARTITION BY grp ORDER BY metric DESC ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS rnk, dense_rank() OVER (PARTITION BY grp ORDER BY metric DESC ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS dr FROM window_rank_input WHERE grp = 1) ranked ORDER BY id;");
----
1 1 1
2 1 1
3 3 2
4 4 3

query IIIII
SELECT grp_key, min(rn), max(rn), count(DISTINCT rn), count(*) FROM (SELECT coalesce(grp, -1) AS grp_key, rn FROM gpu_execution("SELECT grp, row_number() OVER (PARTITION BY grp) AS rn FROM window_rank_input")) ranked GROUP BY grp_key ORDER BY grp_key;
----
-1 1 2 2 2
1 1 4 4 4
2 1 3 3 3
