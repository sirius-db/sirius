# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true

# Large binary test fixtures — track via git-lfs so clones stay lean.
# (Existing committed blobs are not retroactively migrated; this governs
# future additions. Run `git lfs migrate import --include="*.parquet,*.zip"
# --above=512K` separately to migrate history if desired.)
*.parquet filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
