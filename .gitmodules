# Keep the engine and wrapper DuckDB gitlinks on the same revision.
[submodule "duckdb"]
	path = duckdb
	url = https://github.com/duckdb/duckdb.git
	branch = v2.0-cyanoptera
	ignore = dirty
[submodule "substrait"]
	path = substrait
	url = https://github.com/sirius-db/duckdb-substrait-extension.git
	branch = main
[submodule "cucascade"]
	path = cucascade
	url = https://github.com/NVIDIA/cuCascade.git
	branch = main
[submodule ".claude/claude-tools"]
	path = .claude/claude-tools
	url = https://github.com/sirius-db/claude-tools.git
	branch = main
[submodule "sirius-duckdb/vcpkg"]
	path = sirius-duckdb/vcpkg
	url = https://github.com/Microsoft/vcpkg.git
[submodule "starrocks/starrocks"]
	path = experimental/starrocks/starrocks
	url = https://github.com/starrocks/starrocks
[submodule "starrocks/brpc"]
	path = experimental/starrocks/brpc
	url = https://github.com/apache/brpc
[submodule "experimental/doris/doris"]
	path = experimental/doris/doris
	url = https://github.com/apache/doris
	shallow = true
[submodule "sirius-duckdb/duckdb"]
	path = sirius-duckdb/duckdb
	url = https://github.com/duckdb/duckdb.git
[submodule "sirius-duckdb/extension-ci-tools"]
	path = sirius-duckdb/extension-ci-tools
	url = https://github.com/duckdb/extension-ci-tools.git
