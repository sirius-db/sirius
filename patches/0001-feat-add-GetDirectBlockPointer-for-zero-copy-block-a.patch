+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+
 #include "duckdb/catalog/duck_catalog.hpp"
 #include "duckdb/common/allocator.hpp"
 #include "duckdb/common/checksum.hpp"
@@ -1090,6 +1095,30 @@ idx_t SingleFileBlockManager::GetBlockLocation(block_id_t block_id) const {
 	return BLOCK_START + NumericCast<idx_t>(block_id) * GetBlockAllocSize();
 }
 
+data_ptr_t SingleFileBlockManager::GetDirectBlockPointer(block_id_t block_id) {
+	// Only available for read-only, non-encrypted, local databases
+	if (!options.read_only || options.encryption_options.encryption_enabled) {
+		return nullptr;
+	}
+
+	// Lazy-initialize the mmap
+	if (!mmap_base_) {
+		int fd = ::open(path.c_str(), O_RDONLY);
+		if (fd < 0) return nullptr;
+		struct stat st;
+		if (::fstat(fd, &st) < 0) { ::close(fd); return nullptr; }
+		mmap_size_ = static_cast<size_t>(st.st_size);
+		void* mapped = ::mmap(nullptr, mmap_size_, PROT_READ, MAP_SHARED, fd, 0);
+		::close(fd);
+		if (mapped == MAP_FAILED) return nullptr;
+		mmap_base_ = static_cast<data_ptr_t>(mapped);
+	}
+
+	auto location = GetBlockLocation(block_id);
+	if (location + GetBlockHeaderSize() >= mmap_size_) return nullptr;
+	return mmap_base_ + location + GetBlockHeaderSize();
+}
+
 void SingleFileBlockManager::ReadBlock(data_ptr_t internal_buffer, uint64_t block_size, bool skip_block_header) const {
 	//! calculate delta header bytes (if any)
 	uint64_t delta = GetBlockHeaderSize() - Storage::DEFAULT_BLOCK_HEADER_SIZE;
