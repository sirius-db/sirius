# https://clangd.llvm.org/config

# Apply a config conditionally to all C files
If:
    PathMatch: .*\.(c|h)$
CompileFlags:
    Compiler: clang

---
# Apply a config conditionally to all C++ files
If:
    PathMatch: .*\.(c|h)pp
CompileFlags:
    Compiler: clang++

---
# CUDA files: parse as C++ since clang's CUDA frontend causes std type
# corruption from libcudacxx chrono ODR conflicts with libstdc++.
# nvcc handles actual CUDA compilation.
# Note: nvcc puts includes in --options-file (response files) which clangd
# cannot expand. .cu files may have unresolved includes as a result.
If:
    PathMatch: .*\.cuh?
CompileFlags:
    Compiler: clang++
    Add:
        - -x
        - c++
        - "-D__host__="
        - "-D__device__="
        - "-D__global__="
        - "-D__shared__="
        - "-D__constant__="
        - "-D__forceinline__=inline"
        - "-D__launch_bounds__(...)="
    Remove:
        - -x
        - cu

---
# Shared settings for all files
CompileFlags:
    CompilationDatabase: build/release
    Add:
        - "-ferror-limit=0"
        - "-ftemplate-backtrace-limit=0"
    Remove:
        - -stdpar
        # strip CUDA fatbin args
        - "-Xfatbin*"
        - "-Xcompiler*"
        - "-Xcudafe*"
        - "-rdc=*"
        - "-gpu=*"
        - "--diag_suppress*"
        # strip CUDA arch flags
        - "-gencode*"
        - "--generate-code*"
        # strip gcc's -fcoroutines
        - -fcoroutines
        # strip CUDA flags unknown to clang
        - "-ccbin*"
        - "--compiler-options*"
        - "--extended-lambda"
        - "--expt-extended-lambda"
        - "--expt-relaxed-constexpr"
        - "-forward-unknown-to-host-compiler"
        - "-Werror=cross-execution-space-call"
        # nvcc -arch flag (not understood by clang)
        - "-arch*"
Diagnostics:
    Suppress:
        - "variadic_device_fn"
        - "attributes_not_allowed"
        - "template_param_shadow"
