# https://clangd.llvm.org/config

# Apply a config conditionally to all C files
If:
  PathMatch: .*\.(c|h)$

---

# Apply a config conditionally to all C++ files
If:
  PathMatch: .*\.(c|h)pp

---

# Apply a config conditionally to all CUDA files.
# nvcc flags in compile_commands.json are not a CUDA toolchain clang can use:
# clang defaults to sm_52 (no libdevice in CUDA 13), does not read nvcc.profile
# (so libcudf's prefix include is missing), and rejects nvcc's unannotated
# specializations of __host__ __device__ templates. tools/clangd/cuda-toolkit is
# a symlink root created by cmake/sirius-clangd-cuda.cmake. Paths are relative
# to the compilation database directory (build/release).
If:
  PathMatch: .*\.(cu|cuh)$
CompileFlags:
  Add:
    - "-Xclang=-fcuda-allow-variadic-functions"
    - "--cuda-path=../../tools/clangd/cuda-toolkit"
    - "--cuda-gpu-arch=sm_80"
    - "-Wno-unknown-cuda-version"
    - "-foffload-implicit-host-device-templates"
    - "-I../../.pixi/envs/default/include"
    - "-I../../tools/clangd/cuda-compat"
    - "-imacros../../tools/clangd/cuda-compat/nv_rsqrt_specifier.h"
    - "-include../../tools/clangd/cuda-compat/cudf_type_mapping.h"

---

# Device-runtime fragments do not include their siblings; the umbrella header
# includes them in order. Force that umbrella in front of an opened fragment so
# clang sees the same preamble as device_runtime_check.cu. #pragma once makes the
# second read of the fragment a no-op.
If:
  PathMatch: .*/expression_evaluator/nvrtc/device_runtime/.*\.cuh$
CompileFlags:
  Add:
    - "-include../../src/expression_evaluator/nvrtc/device_runtime/device_runtime.cuh"

---

# Tweak the clangd parse settings for all files
CompileFlags:
  CompilationDatabase: ./build/release
  Add:
    # report all errors
    - "-ferror-limit=0"
    - "-ftemplate-backtrace-limit=0"
  Remove:
    - -stdpar
    # strip CUDA fatbin args
    - "-Xfatbin*"
    - "-Xcompiler*"
    - "-Xcudafe*"
    - "-rdc=*"
    - "-gpu=*"
    - "--diag_suppress*"
    # strip CUDA arch flags
    - "-gencode*"
    - "--generate-code*"
    # strip gcc's -fcoroutines
    - -fcoroutines
    # strip C++20 module flags (not supported by clangd)
    - "-fmodules-ts"
    - "-fmodule-mapper*"
    - "-fdeps-format*"
    # strip CUDA flags unknown to clang
    - "-ccbin*"
    - "--compiler-options*"
    - "--extended-lambda"
    - "--expt-extended-lambda"
    - "--expt-relaxed-constexpr"
    - "-forward-unknown-to-host-compiler"
    - "-Werror=cross-execution-space-call"
    - --options-file
Diagnostics:
  Suppress:
    - "variadic_device_fn"
    - "attributes_not_allowed"
    # The NVHPC version of _NVCXX_EXPAND_PACK macro triggers this clang error.
    # Temporarily suppressing it, but should probably fix
    - "template_param_shadow"
