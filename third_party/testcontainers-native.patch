+ * testcontainers-native: required by images such as MinIO that take their mode
+ * from the command (`server /data ...`) with no env-var equivalent.
+ *
+ * @param request_id The container request ID.
+ * @param cmd Pointer to the start of an array of strings (command + arguments).
+ * @param cmd_len Length of the passed array.
+ */
+void tc_container_with_cmd(int request_id, const char** cmd, size_t cmd_len);
