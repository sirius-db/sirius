+++ b/testcontainers-bridge/testcontainers-bridge.go
@@ -70,7 +70,9 @@ func _RunContainer(requestID int) (id int, ok bool, err error) {
 		return containerId, false, err
 	}
 
-	containers = append(containers, &container)
+	// Sirius patch: upstream appended the container to `containers` a second
+	// time here on success, orphaning every other slice index (IDs are indices).
+	// The `if container != nil` block above already registered it; return that id.
 	return containerId, true, nil
 }
 
@@ -229,6 +231,22 @@ func tc_bridge_with_env(requestID int, name *C.cchar_t, value *C.cchar_t) {
 	registerCustomizer(requestID, req)
 }
 
+// tc_bridge_with_cmd sets the command (and its arguments) the container runs,
+// equivalent to a Docker `CMD` / `docker run <image> <cmd...>`. Sirius patch:
+// upstream testcontainers-native has no way to override the command, which the
+// MinIO image requires (`server /data ...`). Mirrors tc_bridge_with_env.
+//
+//export tc_bridge_with_cmd
+func tc_bridge_with_cmd(requestID int, cmd **C.cchar_t, cmdLen C.size_t) {
+	args := ToGoStringSlice(cmd, cmdLen)
+	req := func(req *testcontainers.GenericContainerRequest) error {
+		req.Cmd = args
+		return nil
+	}
+
+	registerCustomizer(requestID, req)
+}
+
 func registerCustomizer(requestID int, customizer testcontainers.CustomizeRequestOption) int {
 	if customizers == nil {
 		customizers = make(map[int][]*testcontainers.CustomizeRequestOption)
